# ---- Public (safe for the browser) ----
NEXT_PUBLIC_SITE_URL=https://www.your-domain.com
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ---- SERVER ONLY — never prefix with NEXT_PUBLIC_ and never commit real values ----
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Comma-separated list of Supabase Auth user emails allowed into /admin
ADMIN_EMAILS=owner@your-domain.com
